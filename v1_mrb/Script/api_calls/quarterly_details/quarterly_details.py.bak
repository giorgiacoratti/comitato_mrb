    @param quarterly_detail_id
"""
def GET_detail(report_id, quarterly_detail_id) :
  path = '/v1/mrb/quarterly-reports/'+report_id+'/quarterly-details/'+quarterly_detail_id
  url = base_url+path
  return generic_calls.send_request_generic('GET', url, token, path)
  
  
  
