## Risultato atteso: 200 OK con response body ListResultMrbQuarterlyReportDto

## Mi salvo report_id
## Descrizione: Vengono cercati tramite filtri i rapporti trimestrali MRB

import sys
sys.path.append(r"C:\Users\gcoratti\Documents\TestComplete15Projects\comitato_mrb\v1_mrb\Script\api_calls\quarterly_report")
sys.path.append(r"C:\Users\gcoratti\Documents\TestComplete15Projects\comitato_mrb\v1_mrb\Script\utils")
sys.path.append(r"C:\Users\gcoratti\Documents\TestComplete15Projects\comitato_mrb\v1_mrb\Script\api_calls")

import utils, constants, json, quarterly_report, quarterly_report_response_schemas

expected_status_code = constants.OK_200
body_file_path = './TestData/requests/body/post_search.json'

def TC0001_POST_ReportSearch():
  
  ## Estraggo il body dal file .json e lo converto in obj per verificarne il formato 
  Log.Message('--- STEP 0: Estraggo il body dal file '+body_file_path)
  
  body_obj = utils.JSON_file_to_obj(body_file_path)
  
#  ## Prendo la variabile legalEntityId
#  if Project.Variables.legal_entity_id :
#    legal_entity_id = Project.Variables.legal_entity_id
#  else:
#    Log.Error('legalEntityId non presente nelle Project Variables! Lanciare l\'Execution Group o valorizzare la Project Variable')
  
  ## Chiamo il servizio
  Log.Message('--- STEP 1: Chiamata al servizio')
  
  Log.Message('Request body: '+json.dumps(body_obj, default=str, indent=4))
  
  resp = quarterly_report.POST_report_search(body_obj)
  
  ## Verifico e leggo lo status code 
  if resp.StatusCode != expected_status_code:
    if resp.Text != '':
      Log.Warning('Messaggio di errore: '+resp.Text)
    Log.Error('Response status NON CORRETTO. Lo status PREVISTO era: '+str(expected_status_code))
  else:
    Log.Message('Response status CORRETTO.')
    
    ## Verifico la response validandola contro lo schema atteso 
    ## Se sono presenti dati li salvo in variabili locali e li loggo 
    Log.Message('--- STEP 2: Validazione della response')
    
    if resp.Text == '':
      Log.Error('La response non contiene un body')
    else:
      response_body_dict = json.loads(resp.Text)
    
      schema = quarterly_report_response_schemas.ListResultMrbQuarterlyReportDto
    
      if not utils.validate(schema, response_body_dict):
        Log.Warning('La risposta del servizio NON rispetta lo schema atteso, verificare')
        Log.Warning('Response body: '+json.dumps(response_body_dict, default=str, indent=4))
        Log.Warning('Schema atteso: '+json.dumps(schema, default=str, indent=4))
        
      else:
        
        Log.Message('La response del servizio rispetta lo schema atteso ListResultMrbQuarterlyReportDto')        
        Log.Message('Item restituito: '+json.dumps(response_body_dict, default=str, indent=4))
        
        if not response_body_dict.get('data')[0]['id']:
          Log.Error('Nel response body non è presente un id, verificare!')
        else:
          Project.Variables.report_id = response_body_dict.get('data')[0]['id']
          Log.Message('E\' stato salvato il report con id: '+str(Project.Variables.report_id))